# mail-imap-mcp-rs example environment
# Copy to .env and replace placeholder values.

# --- Required: default account ---
MAIL_IMAP_DEFAULT_HOST=imap.example.com
MAIL_IMAP_DEFAULT_USER=your-email@example.com
MAIL_IMAP_DEFAULT_PASS=replace-with-app-password

# --- Optional per-account settings (defaults shown) ---
MAIL_IMAP_DEFAULT_PORT=993
MAIL_IMAP_DEFAULT_SECURE=true

# --- Optional additional accounts ---
# MAIL_IMAP_WORK_HOST=outlook.office365.com
# MAIL_IMAP_WORK_USER=user@company.com
# MAIL_IMAP_WORK_PASS=replace-with-work-password
# MAIL_IMAP_WORK_PORT=993
# MAIL_IMAP_WORK_SECURE=true

# MAIL_IMAP_PERSONAL_HOST=imap.fastmail.com
# MAIL_IMAP_PERSONAL_USER=user@fastmail.com
# MAIL_IMAP_PERSONAL_PASS=replace-with-personal-password
# MAIL_IMAP_PERSONAL_PORT=993
# MAIL_IMAP_PERSONAL_SECURE=true

# --- Server-wide settings (defaults shown) ---
# Enable write operations: copy/move/delete/flags
MAIL_IMAP_WRITE_ENABLED=false

# Timeouts (milliseconds)
MAIL_IMAP_CONNECT_TIMEOUT_MS=30000
MAIL_IMAP_GREETING_TIMEOUT_MS=15000
MAIL_IMAP_SOCKET_TIMEOUT_MS=300000

# Cursor pagination
MAIL_IMAP_CURSOR_TTL_SECONDS=600
MAIL_IMAP_CURSOR_MAX_ENTRIES=512

# --- Optional: Admin UI + HTTP MCP transport ---
# Setting any of MAIL_MCP_ADMIN_PORT/TOKEN/KEY (or ADMIN_ENABLED=true)
# turns on the embedded React management UI AND the MCP "Streamable HTTP"
# transport at /mcp on the same HTTP port. AI clients (Cursor, Claude
# Desktop via mcp-remote, etc.) can then connect over the network instead
# of spawning the binary over stdio.
# See docs/admin-ui.md for the threat model and full reference.

# MAIL_MCP_ADMIN_ENABLED=true
# MAIL_MCP_ADMIN_PORT=8080
# MAIL_MCP_ADMIN_HOST=127.0.0.1
# MAIL_MCP_ADMIN_TOKEN=replace-with-a-long-random-string
# MAIL_MCP_ADMIN_KEY=replace-with-a-long-random-string
# MAIL_MCP_DATA_DIR=./data
# MAIL_MCP_UPDATE_CHECK=false

# Disable just the HTTP MCP transport at /mcp (admin UI keeps running):
# MAIL_MCP_HTTP_ENABLED=false
